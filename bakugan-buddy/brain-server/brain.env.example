# Written by setup.sh. Points at the external drive. Do not commit a filled-in copy.
BAKUGAN_DATA_DIR=/Volumes/Agent/agent

# Context window for llama-server. 16384 fits a 16 GB Mac; 24576 also works but
# uses more swap. Leave it unset to take the default in start.sh.
# LLAMA_CTX=16384

# --- Optional free-cloud fallback (Groq, Free plan) ----------------------
# Off unless every line below is set. Preyas stays local by default.
# Leave the key commented out for a fully local, cloud-free install.

# The provider key from console.groq.com. Never commit a real key here.
# GROQ_API_KEY=
# Model id; the default fits the Free plan (30 RPM, 1K RPD, 8K TPM).
# GROQ_MODEL=llama-3.1-8b-instant
# Only needed to point at a test server; must be https in real use.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Chat budget in milliseconds (1000-120000). Default 90000.
# PREYAS_FREE_CLOUD_TIMEOUT_MS=90000
# Health-check budget in milliseconds (50-10000). Default 2500.
# PREYAS_FREE_CLOUD_PROBE_TIMEOUT_MS=2500

# The router flags are documented in docs/PREYAS_FREE_CLOUD.md.
# PREYAS_ROUTER=1
# PREYAS_ROUTER_MODE=fallback
# PREYAS_ROUTER_ALLOW_CLOUD=1
# PREYAS_FREE_CLOUD=1

# --- Optional trackpad voice (github.com/os6/nospeaker) ------------------
# Preyas' lines also come out of the Mac's haptic trackpad motor, so a muted
# Mac still talks. ON by default once nospeaker is in ~/.local/bin.
# Install:  curl -fsSL a90.com/nospeaker | sh     Uninstall:  rm ~/.local/bin/nospeaker
# TRACKPAD_BIN=/Users/you/.local/bin/nospeaker
# TRACKPAD_VOICE=0

# --- Optional Windows helper on the LAN (docs/WINDOWS_HELPER.md) ---------
# Leave these commented out for a Mac-only install. A Tailscale 100.x address
# or a *.ts.net name works in place of the LAN IP. LLAMA_URL is not set here:
# scripts/preyas.sh always points the brain at the Mac's own llama-server.
# WHISPER_URL=http://192.168.31.88:8178
# LLAMA_FALLBACK_URL=http://192.168.31.88:8790
# EMBEDDINGS_URL=http://192.168.31.88:8792/v1/embeddings

