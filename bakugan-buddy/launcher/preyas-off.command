#!/bin/bash
# Double-click launcher generated by scripts/install-desktop-launchers.sh.
# It calls the one Preyas controller script and shows a short result.
set -u

PREFERRED_SCRIPT="__PREYAS_SCRIPT__"
ACTION="stop"
SUCCESS_TITLE="Preyas is OFF"
OPEN_APP=0

find_controller() {
  local candidate
  for candidate in \
    "${PREYAS_CONTROL:-}" \
    "$HOME/Documents/GitHub/AI-Handwriting/scripts/preyas.sh" \
    "/Volumes/Agent/agent/repos/AI-Handwriting/scripts/preyas.sh" \
    "$PREFERRED_SCRIPT" \
    "$HOME/copilot-worktrees/AI-Handwriting/harness-preyas-control/scripts/preyas.sh"; do
    if [[ -n "$candidate" && -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

escape_for_dialog() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n' ' '
}

show_dialog() {
  local title="$1" body="$2"
  if [[ "${PREYAS_NO_DIALOG:-0}" == "1" || ! -x /usr/bin/osascript ]]; then
    printf '%s: %s\n' "$title" "$body"
    return 0
  fi
  /usr/bin/osascript -e "display dialog \"$(escape_for_dialog "$body")\" with title \"Preyas\" buttons {\"OK\"} default button 1 giving up after 30" >/dev/null 2>&1 || true
}

close_terminal_window() {
  [[ "${PREYAS_NO_DIALOG:-0}" == "1" ]] && return 0
  /usr/bin/osascript -e 'tell application "Terminal" to close front window' >/dev/null 2>&1 || true
}

CONTROLLER="$(find_controller)" || {
  show_dialog "Preyas is not installed" "I could not find scripts/preyas.sh. Open the AI-Handwriting folder and run scripts/install-desktop-launchers.sh."
  close_terminal_window
  exit 1
}

OUTPUT="$("$CONTROLLER" "$ACTION" 2>&1)"
RESULT=$?
SUMMARY="$(printf '%s\n' "$OUTPUT" | tail -n 5 | cut -c1-160 | tr '\n' ' ')"

if (( RESULT == 0 )); then
  show_dialog "$SUCCESS_TITLE" "$SUMMARY"
  if [[ "$OPEN_APP" == "1" && "${PREYAS_NO_OPEN:-0}" != "1" ]]; then
    APP_URL="$(printf '%s\n' "$OUTPUT" | grep -Eo 'http://localhost:[0-9]+' | tail -n 1)"
    if [[ -z "$APP_URL" ]]; then
      APP_URL="http://localhost:8081"
    fi
    open "$APP_URL" >/dev/null 2>&1 || true
  fi
else
  show_dialog "Preyas had a problem" "$SUMMARY Logs: /Volumes/Agent/agent/logs/preyas/"
fi

close_terminal_window
exit "$RESULT"
